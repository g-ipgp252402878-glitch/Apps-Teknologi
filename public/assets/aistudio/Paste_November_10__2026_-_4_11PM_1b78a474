    COLOR_CHOICES.forEach(c => {
      const btn = document.createElement('div');
      btn.className = 'color-circle' + (friendData.color === c ? ' selected' : '');
      btn.style.backgroundColor = c;
      btn.onclick = () => { friendData.color = c; refreshAvatars(); initPalettes(); playSoundClick(); };
      fColBox.appendChild(btn);
    });

    // Friend Paw Color
    const fPawBox = document.getElementById('friendPawPalette');
    fPawBox.innerHTML = '';
    PAW_CHOICES.forEach(p => {
      const btn = document.createElement('div');
      btn.className = 'paw-pill' + (friendData.pawColor === p.color ? ' selected' : '');
      btn.innerHTML = `<span style="width:14px; height:14px; border-radius:50%; background:${p.color}; border:1px solid #94a3b8; display:inline-block;"></span> ${p.label}`;
      btn.onclick = () => { friendData.pawColor = p.color; refreshAvatars(); initPalettes(); playSoundClick(); };
