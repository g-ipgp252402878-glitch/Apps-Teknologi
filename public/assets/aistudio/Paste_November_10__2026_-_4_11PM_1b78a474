  let currentChapterIdx = 0;

  function loadChapter(idx) {
    currentChapterIdx = idx;
    const scene = STORY_SCENES[idx];
    document.getElementById('chapterTitle').innerText = scene.title;
    document.getElementById('pageIndicator').innerText = `Babak ${idx + 1} / 7`;
    document.getElementById('stageBg').innerHTML = scene.bgSvg;
    document.getElementById('speakerTag').innerText = scene.speaker;

    // Gantikan nama wira & sahabat dalam teks
    const formatted = scene.text
      .replace('Sang Belang Wira', heroData.name)
      .replace('sahabat akrabnya', heroData.name + ' dan ' + friendData.name)
      .replace('sahabat wira', friendData.name);

    document.getElementById('dialogueText').innerText = formatted;

    const bearEl = document.getElementById('stageBear');
    if (idx === 1 || idx === 5) {
      bearEl.style.display = 'flex';
    } else {
      bearEl.style.display = 'none';
    }
    refreshAvatars();
  }

  function nextDialogue() {
    if (currentChapterIdx < STORY_SCENES.length - 1) {
      loadChapter(currentChapterIdx + 1);
      speakCurrentDialogue();
    } else {
      navigateTo('screen-quiz');
    }
  }

  function jumpChapter(idx) {
    loadChapter(idx);
    playSoundClick();
  }

  function speakCurrentDialogue() {
    const text = document.getElementById('dialogueText').innerText;
    speakText(text);
  }

  // --- KUIZ PERSAHABATAN ---
  const QUIZ_LIST = [
    {
      q: 'Apakah tindakan terbaik apabila melihat kawan baik anda duduk bersendirian dan menangis?',
      options: [
        { text: 'Duduk di sampingnya dengan lembut dan mendengar luahannya.', correct: true, exp: 'Tepat sekali! Menjadi pendengar empati memberi kelegaan jiwa.' },
