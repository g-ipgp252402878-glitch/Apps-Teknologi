  function setSticker(stk) {
    document.getElementById('activeStickerDisplay').innerText = stk;
    playSoundClick();
  }

  function saveMemory() {
    playSoundClick();
    speakText('Kenangan persahabatan anda telah berjaya disimpan!');
    navigateTo('screen-studio');
  }

  // --- NAVIGASI ANTARA SKRIN ---
  function navigateTo(screenId) {
    playSoundClick();
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');

    // Kemas kini teks panduan suara mengikut skrin
    const vText = document.getElementById('voiceText');
    if (screenId === 'screen-home') {
      vText.innerText = '"Selamat datang ke Pengembaraan Hutan! Pilih aktiviti untuk memulakan misi anda!"';
    } else if (screenId === 'screen-studio') {
      vText.innerText = '"Cipta wira haiwan anda! Anda kini boleh mengubah warna tapak tangan (paws) dan bulunya!"';
    } else if (screenId === 'screen-friend-studio') {
      vText.innerText = '"Cipta watak sahabat baik anda yang bakal diselamatkan dalam cerita nanti!"';
    } else if (screenId === 'screen-video') {
      vText.innerText = '"Tonton animasi buku cerita 7 babak dan hayati bagaimana empati merawat kesedihan!"';
    } else if (screenId === 'screen-book') {
      vText.innerText = '"Tuliskan janji ikrar persahabatan dan pilih pelekat comel untuk diari anda!"';
    } else if (screenId === 'screen-quiz') {
      vText.innerText = '"Jawab 5 soalan kuiz nilai persahabatan untuk menguji pemahaman anda!"';
    } else if (screenId === 'screen-cave') {
      vText.innerText = '"Sematkan 3 Kunci Empati untuk membuka pintu gua dan bebaskan kawan anda!"';
    } else if (screenId === 'screen-cert') {
      vText.innerText = '"Tahniah! Anda telah berjaya menamatkan misi dan layak menerima Sijil Sahabat Hebat!"';
    }

    refreshAvatars();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // --- PELANCARAN AWAL ---
  window.addEventListener('DOMContentLoaded', () => {
    initPalettes();
    refreshAvatars();
    loadChapter(0);
    loadQuiz(0);
    document.getElementById('certDate').innerText = new Date().toLocaleDateString('ms-MY', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
  });
</script>
