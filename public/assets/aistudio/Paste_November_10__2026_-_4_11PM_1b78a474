  // --- SVG ANIMAL AVATAR GENERATOR (DENGAN WARNA TAPAK TANGAN & TOE BEANS) ---
  function renderAvatarSvg(type, color, pawColor, accessory, size = 110, isSad = false, isTrapped = false) {
    const baseColor = color || '#f4a261';
    const paw = pawColor || '#ffffff';
    const toeBean = (paw === '#fbcfe8' || paw === '#f43f5e') ? '#ffffff' : '#f43f5e';

    let ears = '';
    if (type === 'rabbit') {
      ears = `<ellipse cx="40" cy="22" rx="10" ry="28" fill="${baseColor}" stroke="#cbd5e1" stroke-width="2" transform="rotate(-10 40 22)" />
              <ellipse cx="40" cy="22" rx="5" ry="18" fill="#f472b6" transform="rotate(-10 40 22)" />
              <ellipse cx="80" cy="22" rx="10" ry="28" fill="${baseColor}" stroke="#cbd5e1" stroke-width="2" transform="rotate(10 80 22)" />
              <ellipse cx="80" cy="22" rx="5" ry="18" fill="#f472b6" transform="rotate(10 80 22)" />`;
    } else if (type === 'cat' || type === 'fox') {
      ears = `<polygon points="25,50 38,15 55,44" fill="${baseColor}" stroke="#b45309" stroke-width="2" />
              <polygon points="32,44 40,24 50,40" fill="#fbcfe8" />
              <polygon points="95,50 82,15 65,44" fill="${baseColor}" stroke="#b45309" stroke-width="2" />
              <polygon points="88,44 80,24 70,40" fill="#fbcfe8" />`;
    } else {
      // Round teddy / tiger / panda ears
      ears = `<circle cx="32" cy="36" r="16" fill="${type === 'panda' ? '#0f172a' : baseColor}" stroke="#451a03" stroke-width="2" />
              <circle cx="32" cy="36" r="8" fill="#fde68a" />
              <circle cx="88" cy="36" r="16" fill="${type === 'panda' ? '#0f172a' : baseColor}" stroke="#451a03" stroke-width="2" />
              <circle cx="88" cy="36" r="8" fill="#fde68a" />`;
    }

    let accSvg = '';
    if (accessory === 'bandana') {
      accSvg = `<polygon points="36,88 84,88 60,110" fill="#ef4444" stroke="#991b1b" stroke-width="1.5" />
                <circle cx="60" cy="94" r="2.5" fill="#fff" />`;
    } else if (accessory === 'crown') {
      accSvg = `<polygon points="40,38 44,20 52,30 60,16 68,30 76,20 80,38" fill="#fbbf24" stroke="#d97706" stroke-width="1.5" />`;
    } else if (accessory === 'flower') {
      accSvg = `<circle cx="80" cy="40" r="4.5" fill="#f43f5e" /><circle cx="80" cy="40" r="2" fill="#fde047" />`;
    } else if (accessory === 'glasses') {
      accSvg = `<circle cx="48" cy="62" r="10" stroke="#2563eb" stroke-width="2.5" fill="none" />
                <circle cx="72" cy="62" r="10" stroke="#2563eb" stroke-width="2.5" fill="none" />
                <line x1="58" y1="62" x2="62" y2="62" stroke="#2563eb" stroke-width="2.5" />`;
    }

    const cageSvg = isTrapped ? `<rect x="10" y="10" width="100" height="100" rx="14" fill="rgba(15,23,42,0.4)" />
                                 <line x1="30" y1="15" x2="30" y2="105" stroke="#94a3b8" stroke-width="4" />
                                 <line x1="60" y1="15" x2="60" y2="105" stroke="#94a3b8" stroke-width="4" />
                                 <line x1="90" y1="15" x2="90" y2="105" stroke="#94a3b8" stroke-width="4" />` : '';

    return `
      <svg width="${size}" height="${size}" viewBox="0 0 120 120" style="display:block;">
        ${ears}
        <!-- Chubby Head -->
        <circle cx="60" cy="68" r="38" fill="${baseColor}" stroke="#0f172a" stroke-width="2" />
