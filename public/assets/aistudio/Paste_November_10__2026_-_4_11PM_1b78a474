        <circle cx="84" cy="72" r="6" fill="#fb7185" opacity="0.75" />
        <!-- Chubby Muzzle -->
        <ellipse cx="60" cy="74" rx="18" ry="13" fill="#ffffff" />
        <circle cx="60" cy="70" r="3.5" fill="#0f172a" />
        ${isSad ? `<path d="M 54 80 Q 60 75 66 80" stroke="#0f172a" stroke-width="2.5" fill="none" />`
                : `<path d="M 54 77 Q 57 82 60 78 Q 63 82 66 77" stroke="#0f172a" stroke-width="2" fill="none" />`}
        <!-- Sparkling Kawaii Eyes -->
        <ellipse cx="46" cy="60" rx="6" ry="7" fill="#0f172a" />
        <circle cx="44" cy="58" r="2.5" fill="#ffffff" />
        <ellipse cx="74" cy="60" rx="6" ry="7" fill="#0f172a" />
        <circle cx="72" cy="58" r="2.5" fill="#ffffff" />

        <!-- TAPAK TANGAN DEPAN (PAWS & TOE BEANS) DENGAN WARNA BOLEH DIUBAH -->
        <!-- Tapak Kiri -->
        <ellipse cx="42" cy="102" rx="11" ry="8" fill="${paw}" stroke="#64748b" stroke-width="1.5" />
        <circle cx="38" cy="100" r="2" fill="${toeBean}" />
        <circle cx="42" cy="98" r="2" fill="${toeBean}" />
        <circle cx="46" cy="100" r="2" fill="${toeBean}" />
        <ellipse cx="42" cy="103" rx="4" ry="2.5" fill="${toeBean}" opacity="0.8" />

        <!-- Tapak Kanan -->
        <ellipse cx="78" cy="102" rx="11" ry="8" fill="${paw}" stroke="#64748b" stroke-width="1.5" />
        <circle cx="74" cy="100" r="2" fill="${toeBean}" />
        <circle cx="78" cy="98" r="2" fill="${toeBean}" />
        <circle cx="82" cy="100" r="2" fill="${toeBean}" />
        <ellipse cx="78" cy="103" rx="4" ry="2.5" fill="${toeBean}" opacity="0.8" />

        ${accSvg}
        ${cageSvg}
      </svg>
    `;
  }

  // --- RE-RENDER ALL AVATARS ACROSS APP ---
  function refreshAvatars() {
    const heroSvg = renderAvatarSvg(heroData.type, heroData.color, heroData.pawColor, heroData.accessory, 120);
    const heroMiniSvg = renderAvatarSvg(heroData.type, heroData.color, heroData.pawColor, heroData.accessory, 65);
    const friendSvg = renderAvatarSvg(friendData.type, friendData.color, friendData.pawColor, friendData.accessory, 120);
    const friendMiniSvg = renderAvatarSvg(friendData.type, friendData.color, friendData.pawColor, friendData.accessory, 65);

    document.getElementById('homeHeroAvatar').innerHTML = heroMiniSvg;
    document.getElementById('homeFriendAvatar').innerHTML = friendMiniSvg;
    document.getElementById('homeDuoNames').innerText = `${heroData.name} & ${friendData.name}`;

    document.getElementById('heroPreviewBox').innerHTML = heroSvg;
    document.getElementById('friendPreviewBox').innerHTML = friendSvg;

    document.getElementById('stageHero').innerHTML = `${heroMiniSvg}<span style="background:#fff; font-size:0.75rem; font-weight:800; padding:2px 8px; border-radius:50px; margin-top:2px;">${heroData.name}</span>`;
    document.getElementById('stageFriend').innerHTML = `${friendMiniSvg}<span style="background:#fff; font-size:0.75rem; font-weight:800; padding:2px 8px; border-radius:50px; margin-top:2px;">${friendData.name}</span>`;
    document.getElementById('stageBear').innerHTML = `${renderAvatarSvg('bear', '#78350f', '#573e31', 'none', 70, true)}<span style="background:#000; color:#fef08a; font-size:0.75rem; font-weight:800; padding:2px 8px; border-radius:50px; margin-top:2px;">Pak Beruang</span>`;

    document.getElementById('bookPolaroidHero').innerHTML = heroMiniSvg;
    document.getElementById('bookPolaroidFriend').innerHTML = friendMiniSvg;

    document.getElementById('caveHero').innerHTML = `${heroSvg}<strong style="color:#fde047; display:block; margin-top:4px;">${heroData.name}</strong>`;
    document.getElementById('caveFriend').innerHTML = `${renderAvatarSvg(friendData.type, friendData.color, friendData.pawColor, friendData.accessory, 120, !allKeysUnlocked, !allKeysUnlocked)}<strong style="color:#f43f5e; display:block; margin-top:4px;">${friendData.name}</strong>`;

    document.getElementById('certHeroAvatar').innerHTML = heroMiniSvg;
    document.getElementById('certFriendAvatar').innerHTML = friendMiniSvg;
    document.getElementById('certHeroName').innerText = heroData.name;
    document.getElementById('certFriendName').innerText = friendData.name;
  }

  // --- INITIALIZE PALETTES ---
  function initPalettes() {
    // Hero Fur Color
    const hColBox = document.getElementById('heroColorPalette');
    hColBox.innerHTML = '';
    COLOR_CHOICES.forEach(c => {
      const btn = document.createElement('div');
      btn.className = 'color-circle' + (heroData.color === c ? ' selected' : '');
      btn.style.backgroundColor = c;
      btn.onclick = () => { heroData.color = c; refreshAvatars(); initPalettes(); playSoundClick(); };
      hColBox.appendChild(btn);
    });

    // Hero Paw Color
    const hPawBox = document.getElementById('heroPawPalette');
    hPawBox.innerHTML = '';
    PAW_CHOICES.forEach(p => {
      const btn = document.createElement('div');
      btn.className = 'paw-pill' + (heroData.pawColor === p.color ? ' selected' : '');
