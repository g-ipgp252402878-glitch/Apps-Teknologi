      btn.onclick = () => { heroData.pawColor = p.color; refreshAvatars(); initPalettes(); playSoundClick(); };
      hPawBox.appendChild(btn);
    });

    // Friend Fur Color
    const fColBox = document.getElementById('friendColorPalette');
