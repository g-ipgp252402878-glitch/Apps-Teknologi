  let currentQuizIdx = 0;
  let quizScore = 0;

  function loadQuiz(idx) {
    currentQuizIdx = idx;
    const qData = QUIZ_LIST[idx];
    document.getElementById('quizCounter').innerText = `Soalan ${idx + 1} daripada ${QUIZ_LIST.length}`;
    document.getElementById('quizQuestionText').innerText = qData.q;
    const optBox = document.getElementById('quizOptionsContainer');
    optBox.innerHTML = '';

    const feedBox = document.getElementById('quizFeedbackBox');
    feedBox.style.display = 'none';
    document.getElementById('quizNextBtn').style.display = 'none';

    qData.options.forEach((opt, oIdx) => {
      const btn = document.createElement('button');
      btn.className = 'quiz-option';
      btn.innerText = opt.text;
      btn.onclick = () => answerQuiz(oIdx);
      optBox.appendChild(btn);
    });
  }

  function answerQuiz(chosenIdx) {
    const qData = QUIZ_LIST[currentQuizIdx];
    const buttons = document.querySelectorAll('.quiz-option');
    buttons.forEach((btn, idx) => {
      btn.disabled = true;
      if (qData.options[idx].correct) {
        btn.classList.add('correct');
      } else if (idx === chosenIdx) {
        btn.classList.add('wrong');
      }
    });

    const isCorrect = qData.options[chosenIdx].correct;
    const feedBox = document.getElementById('quizFeedbackBox');
    feedBox.style.display = 'block';

    if (isCorrect) {
      quizScore++;
      feedBox.style.background = '#dcfce7';
      feedBox.style.color = '#14532d';
      feedBox.innerHTML = `<strong>✨ Tahniah! Jawapan Tepat!</strong><p>${qData.options[chosenIdx].exp}</p>`;
      speakText('Tahniah! Jawapan anda tepat. ' + qData.options[chosenIdx].exp);
    } else {
      feedBox.style.background = '#fee2e2';
      feedBox.style.color = '#7f1d1d';
      feedBox.innerHTML = `<strong>💡 Renungan:</strong><p>${qData.options[chosenIdx].exp}</p>`;
      speakText('Kurang tepat. ' + qData.options[chosenIdx].exp);
    }

    document.getElementById('quizScoreText').innerText = 'Skor: ' + '⭐'.repeat(quizScore) + '☆'.repeat(QUIZ_LIST.length - quizScore);
    document.getElementById('quizNextBtn').style.display = 'block';
  }

  function nextQuizQuestion() {
    if (currentQuizIdx < QUIZ_LIST.length - 1) {
      loadQuiz(currentQuizIdx + 1);
    } else {
      navigateTo('screen-cave');
    }
  }

  // --- GUA MASALAH TERPENDAM ---
  let unlockedKeys = { 1: false, 2: false, 3: false };
  let allKeysUnlocked = false;

  function unlockKey(id) {
    unlockedKeys[id] = true;
    document.getElementById(`key${id}Btn`).style.background = '#22c55e';
    document.getElementById(`key${id}Btn`).style.color = '#fff';
    playSoundClick();

    if (unlockedKeys[1] && unlockedKeys[2] && unlockedKeys[3]) {
      allKeysUnlocked = true;
      document.getElementById('caveDoorLock').innerText = '🔓';
      document.getElementById('caveDoorStatus').innerText = '✨ Pintu Gua Terbuka Luas!';
      document.getElementById('caveCompleteBtn').style.display = 'inline-block';
      refreshAvatars();
      speakText('Hebat! Semua Kunci Empati berjaya dibuka dan kawan baik anda kini bebas!');
    } else {
      speakText(`Kunci nombor ${id} berjaya disematkan! Hati Pak Beruang semakin tenang.`);
    }
  }

